{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "gen:types": "openapi-typescript openapi.json -o src/types/generated.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@sentry/react": "^10.74.0",
    "@types/react-signature-canvas": "^1.0.7",
    "axios": "^1.20.0",
    "dompurify": "^3.4.15",
    "i18next": "^26.4.2",
    "jwt-decode": "^4.0.0",
    "lenis": "^1.3.26",
    "marked": "^18.0.12",
    "motion": "^13.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.0.13",
    "react-router-dom": "^7.18.3",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "comment:typescript": "Pinned to 6.0.x on purpose: typescript-eslint peers `typescript >=4.8.4 <6.1.0` and has no release that accepts 6.1+ or 7.x, so raising this breaks `npm ci` with ERESOLVE. Dependabot is told to hold it too (.github/dependabot.yml). Lift both together once typescript-eslint supports the newer compiler.",
  "comment:overrides": "openapi-typescript's peer range stops at typescript@5 but it works with our TS6 for JSON->TS codegen; pin it to the root typescript so npm resolves cleanly (plain npm ci) instead of relaxing peer checks project-wide.",
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
